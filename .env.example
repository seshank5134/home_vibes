# ==============================================================================
# HomeVibes — Environment Configuration Template
# Copy this file to .env and configure the respective values.
# NEVER commit your actual .env with real secret keys to version control!
# ==============================================================================

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-supabase-service-role-key-keep-private

# Google Maps Platform Configuration (For Web & Flutter Driver GPS)
GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-api-key

# Firebase Cloud Messaging (FCM) Configuration
FIREBASE_PROJECT_ID=homevibes-cloud
FIREBASE_SERVER_KEY=AAAA...your-fcm-server-key

# Central Kitchen Location Defaults (For distance and map centering)
CENTRAL_KITCHEN_NAME=HomeVibes Central Kitchen
CENTRAL_KITCHEN_LAT=12.9715987
CENTRAL_KITCHEN_LNG=77.5945627
CENTRAL_KITCHEN_ADDRESS=Brigade Road, Central Hub, Bengaluru, KA 560001
